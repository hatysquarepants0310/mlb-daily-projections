[Unit]
Description=mlbproj dashboard (bind the host you actually want)
After=network-online.target

[Service]
WorkingDirectory=%h/mlb-daily-projections
ExecStart=%h/mlb-daily-projections/.venv/bin/python -m mlbproj.web --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
